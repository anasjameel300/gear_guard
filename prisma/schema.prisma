// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  TECHNICIAN
  MANAGER
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  DOWN
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  REPAIRED
  SCRAP
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum RequestType {
  CORRECTIVE
  PREVENTIVE
}

enum ActivityType {
  TICKET_CREATED
  TICKET_STATUS_CHANGE
  TEAM_CREATED
  USER_INVITED
  EQUIPMENT_ADDED
  EQUIPMENT_UPDATED
}

// ============================================
// MODELS
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(TECHNICIAN)
  avatarUrl    String?  @map("avatar_url")
  department   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  leadingTeams      Team[]              @relation("TeamLead")
  teamMemberships   TeamMember[]
  assignedEquipment Equipment[]         @relation("AssignedTechnician")
  assignedTickets   MaintenanceTicket[] @relation("TicketAssignee")
  activities        ActivityLog[]

  @@map("users")
}

model Team {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  leadTechnicianId String?      @map("lead_technician_id")
  leadTechnician   User?        @relation("TeamLead", fields: [leadTechnicianId], references: [id], onDelete: SetNull)
  members          TeamMember[]
  equipment        Equipment[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Equipment {
  id                 String          @id @default(cuid())
  name               String
  serialNumber       String          @unique @map("serial_number")
  status             EquipmentStatus @default(OPERATIONAL)
  location           String
  department         String
  category           String
  assignedTo         String?         @map("assigned_to") // Employee name (for personal assets like laptops)
  imageUrl           String?         @map("image_url")
  purchaseDate       DateTime        @map("purchase_date")
  warrantyExpiration DateTime        @map("warranty_expiration")
  lastMaintenance    DateTime?       @map("last_maintenance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  maintenanceTeamId String?             @map("maintenance_team_id")
  maintenanceTeam   Team?               @relation(fields: [maintenanceTeamId], references: [id], onDelete: SetNull)
  technicianId      String?             @map("technician_id")
  technician        User?               @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  tickets           MaintenanceTicket[]

  @@map("equipment")
}

model MaintenanceTicket {
  id            String         @id @default(cuid())
  title         String
  description   String
  status        TicketStatus   @default(NEW)
  priority      TicketPriority @default(MEDIUM)
  type          RequestType    @default(CORRECTIVE)
  scheduledDate DateTime?      @map("scheduled_date")
  duration      String?        // e.g., "2 hours"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  equipmentId  String    @map("equipment_id")
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assignedToId String?   @map("assigned_to_id")
  assignee     User?     @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("maintenance_tickets")
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  timestamp DateTime     @default(now())

  // Optional: Link to entity that was affected
  entityType String? @map("entity_type") // e.g., "equipment", "ticket", "team"
  entityId   String? @map("entity_id")

  // Relations
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemOption {
  id    String @id @default(cuid())
  type  String // "category", "department", "location"
  value String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, value])
  @@map("system_options")
}
